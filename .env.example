# Baham Bebinim — example production settings
# Keep the Node server private behind Nginx. Change HOST only when you intentionally
# need another bind address (for example inside a container).
HOST=127.0.0.1
PORT=3001

# Conservative defaults for a small public VPS. Tune after measuring real traffic.
BAHAM_BEBINIM_MAX_CONNECTIONS=200
BAHAM_BEBINIM_MAX_ROOM_MEMBERS=50
BAHAM_BEBINIM_MAX_ACTIVE_ROOMS=1000
BAHAM_BEBINIM_CHAT_TEMP_MAX_MB=256

# Saved videos are long-lived and have no TTL. Limits prevent accidental disk abuse.
BAHAM_BEBINIM_USER_SAVES_MAX=200
BAHAM_BEBINIM_SAVED_PROFILE_MAX=5000

# Optional custom storage paths
# BAHAM_BEBINIM_DATA_DIR=/home/your-user/.baham-bebinim
# BAHAM_BEBINIM_USER_SAVES_DIR=/home/your-user/.baham-bebinim/saved-videos
# BAHAM_BEBINIM_PROGRESS_FILE=/home/your-user/.baham-bebinim/room-progress.json
# BAHAM_BEBINIM_CHAT_UPLOAD_DIR=/tmp/baham-bebinim-chat
